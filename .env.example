# Copy this file to .env and fill in real values for local development.
# .env is gitignored - never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=crewflow
POSTGRES_USER=crewflow
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_PORT=5432

# --- API ---
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
AUTO_MIGRATE=true

# Symmetric signing key for access/refresh JWTs issued by the API (dev only - use a long random string)
JWT_SIGNING_KEY=dev_super_secret_signing_key_change_me_please_32chars_min
JWT_ISSUER=crewflow-api
JWT_AUDIENCE=crewflow-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Stripe (test mode keys - https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder

# --- Web (Next.js) ---
WEB_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_nextauth_secret_change_me
API_BASE_URL=http://api:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
